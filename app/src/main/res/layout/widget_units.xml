<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="7dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">
            <TextView
                android:id="@+id/widget_y"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/anton"
                android:gravity="center"
                android:maxLines="1"
                android:text="00"
                android:textColor="#FFEDE3DC" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="YEARS"
                android:textColor="#FF8F7C78"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">
            <TextView
                android:id="@+id/widget_mo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/anton"
                android:gravity="center"
                android:maxLines="1"
                android:text="00"
                android:textColor="#FFEDE3DC" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="MONTHS"
                android:textColor="#FF8F7C78"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">
            <TextView
                android:id="@+id/widget_d"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/anton"
                android:gravity="center"
                android:maxLines="1"
                android:text="00"
                android:textColor="#FFEDE3DC" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="DAYS"
                android:textColor="#FF8F7C78"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">
            <TextView
                android:id="@+id/widget_h"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/anton"
                android:gravity="center"
                android:maxLines="1"
                android:text="00"
                android:textColor="#FFEDE3DC" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="HOURS"
                android:textColor="#FF8F7C78"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">
            <TextView
                android:id="@+id/widget_mi"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/anton"
                android:gravity="center"
                android:maxLines="1"
                android:text="00"
                android:textColor="#FFEDE3DC" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="MINUTES"
                android:textColor="#FF8F7C78"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_cell_live"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">
            <TextView
                android:id="@+id/widget_s"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/anton"
                android:gravity="center"
                android:maxLines="1"
                android:text="00"
                android:textColor="#FFC4001A" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="SECONDS"
                android:textColor="#FF8F7C78"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
